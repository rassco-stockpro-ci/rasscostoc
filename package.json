{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3001 tsx apps/api/src/server.ts",
    "dev:clean": "node scripts/kill-port.cjs 3001 && npm run dev",
    "build:packages": "tsc -p packages/ai-extraction/tsconfig.json",
    "build": "npm run build:packages && vite build && esbuild apps/api/src/server.ts --platform=node --packages=external --bundle --format=esm --splitting --minify --sourcemap=external --metafile=dist/meta.json --outdir=dist && node scripts/write-release-sha.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:safe": "node scripts/test-unit-safe.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:http": "node scripts/test-http-foundation.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:portal": "vitest run apps/portal",
    "test:e2e": "playwright test",
    "check": "tsc -p tsconfig.runtime-check.json",
    "check:full": "tsc -p tsconfig.json",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json apps/api/src",
    "lint:architecture:strict": "depcruise --config .dependency-cruiser.cjs apps/api/src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:erp002:audit": "node scripts/erp002-migration-audit.mjs",
    "db:erp002:catch-up-dry": "node scripts/erp002-migration-audit.mjs --catch-up-dry-run",
    "db:erp002:catch-up": "node scripts/erp002-migration-audit.mjs --catch-up",
    "db:erp002:greenfield-proof": "node scripts/erp002-greenfield-migrate-proof.mjs",
    "db:drift-check": "node scripts/erp008-drift-check.mjs",
    "db:backup-drill": "node scripts/erp008-backup-drill.mjs",
    "db:item-types:constraints": "tsx scripts/apply-item-types-constraints.ts",
    "ops-perm:s2:backfill": "tsx scripts/ops-perm-s2-backfill-supervisor-grants.ts",
    "smoke:api": "node scripts/smoke-api.cjs",
    "smoke:erp003": "node scripts/erp003-postdeploy-verify.mjs",
    "prepare": "husky",
    "ops": "node scripts/ops/run.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
