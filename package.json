    "cross-env": "^7.0.3",
    "dependency-cruiser": "^18.0.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "husky": "^9.0.11",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "turbo": "^2.0.4",
    "typescript": "5.6.3",
