# Zero Local Storage: runtime PDF directories must never be tracked in git.
# The application creates these directories on demand (mkdirSync recursive)
# when/if it writes to them, so no placeholder file is required to keep
# them present.
/uploads/pdf/**
/uploads/courier-pdf/**
/apps/api/uploads/pdf/**
/uploads/test-files/*.pdf

# Untracked (not deleted) from git: suspected to contain real
# transfer-record data, unreferenced by any functional code. Preserved in
# git history at commit 0776825 and after. Exact path only, no wildcard.
/attached_assets/transfer_2026-01-28_cab0b9c0_1769590127519.pdf

